---
const repo = 'https://github.com/jlfernandezfernandez/gym-tracker';
const demo = import.meta.env.PUBLIC_DEMO_URL || 'https://gym.jordixlab.com/demo';
const home = import.meta.env.BASE_URL;
---

<header class="overflow-hidden border-b border-edge">
	<nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8">
		<a href={home} class="flex items-center gap-2 font-[750] tracking-[0] text-ink">
			<span class="grid size-8 place-items-center rounded-xl bg-dark text-sm text-white">G</span>
			Gym Tracker
		</a>
		<div class="flex items-center gap-5 text-sm text-hint">
			<a href="#producto" class="hidden hover:text-ink sm:block">Producto</a>
			<a href="#instalar" class="hidden hover:text-ink sm:block">Instalar</a>
			<a href={repo} class="rounded-xl border border-edge bg-surface px-3.5 py-2 font-semibold text-ink shadow-sm transition-transform duration-150 active:scale-[.97]">GitHub ↗</a>
		</div>
	</nav>

	<div class="mx-auto max-w-7xl px-5 pt-10 pb-12 sm:px-8 sm:pt-14 sm:pb-14 lg:pt-18 lg:pb-16">
		<div class="max-w-3xl">
			<p class="mb-5 font-mono text-[.7rem] font-bold tracking-[0] text-accent uppercase">Telegram · MCP · Self-hosted</p>
			<h1 class="font-display text-[3.4rem] leading-[.94] font-[760] tracking-[0] text-balance sm:text-[4.6rem] lg:text-[5.5rem] xl:text-[6.1rem]">
				Gym Tracker
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-hint sm:text-xl">
				Ten tu rutina a mano, anota cada serie y sigue tu progreso.
			</p>
			<p class="mt-3 max-w-xl text-sm leading-relaxed text-hint sm:text-[0.98rem]">
				Abre tu sesión desde Telegram. Consulta qué toca y ajusta pesos o ejercicios mientras entrenas.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={demo} target="_blank" rel="noopener" class="rounded-control bg-dark px-5 py-3 font-semibold text-white transition-transform duration-150 active:scale-[.97]">Probar demo</a>
				<a href="#instalar" class="rounded-control border border-edge bg-surface px-5 py-3 font-semibold text-ink transition-transform duration-150 active:scale-[.97]">Instalar Gym Tracker</a>
			</div>
			<div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-hint">
				<p>Código abierto · licencia MIT · tus datos en tu servidor</p>
				<a href="#producto" class="font-medium text-ink transition-colors hover:text-accent">Ver la app ↓</a>
			</div>
		</div>
	</div>
</header>
