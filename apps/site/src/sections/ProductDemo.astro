---
const demo = import.meta.env.PUBLIC_DEMO_URL || 'https://gym.jordixlab.com/demo';
---

<section id="producto" class="border-y border-edge bg-dark py-20 text-white lg:py-28">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<div class="max-w-2xl">
				<p class="font-mono text-[.68rem] font-bold tracking-[0] text-white/60 uppercase">Durante el entreno</p>
				<h2 class="mt-3 font-display text-4xl leading-tight font-[760] tracking-[0] text-balance sm:text-5xl">Tu entrenamiento, en Gym Tracker.</h2>
			</div>
			<a href={demo} target="_blank" rel="noopener" class="rounded-control bg-white px-5 py-3 font-semibold text-dark transition-transform duration-150 active:scale-[.97]">Abrir demo ↗</a>
		</div>
		<iframe
			title="Demo de Gym Tracker con datos ficticios"
			src={demo}
			loading="lazy"
			class="mt-10 block h-[720px] w-full border-0 bg-white"
		/>
	</div>
</section>
